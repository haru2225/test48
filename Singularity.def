Bootstrap: docker
From: pytorch/pytorch:2.5.0-cuda12.4-cudnn9-runtime

%labels
    Description "PyTorch CUDA + e3nn 0.4.4 runtime for test48 (DM2/graphite bound at runtime, not baked in)"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates libgomp1
    rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir --upgrade pip
    python -m pip install --no-cache-dir \
        numpy==1.26.4 \
        scipy \
        pandas \
        scikit-learn==1.6.1 \
        matplotlib==3.9.4 \
        ase==3.29.0 \
        tqdm \
        ipywidgets \
        torch-geometric==2.6.1 \
        e3nn==0.4.4
    # DM2 (the `graphite` package) is deliberately NOT installed here -- pip installing it from
    # GitHub during the build requires github.com access from the build node, which some sites'
    # build/compute nodes cannot reach even when Docker Hub / PyPI are reachable. Instead, DM2 is
    # bind-mounted at RUN time and found via PYTHONPATH (see run_test48.pbs), matching
    # test45/46/47's own approach -- only Docker Hub and PyPI need to be reachable to build this.

%environment
    export PYTHONNOUSERSITE=1
    export PYTHONUNBUFFERED=1
    export MPLBACKEND=Agg
    export MPLCONFIGDIR=/tmp/matplotlib-test48

%test
    python -c "import ase, e3nn, torch, torch_geometric; print('torch', torch.__version__, 'e3nn', e3nn.__version__)"
    # graphite is not on PYTHONPATH at build time (bound at run time); not checked here.
